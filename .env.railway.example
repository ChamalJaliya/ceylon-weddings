# =============================================================================
# Railway → API service → Variables
# Attach Postgres + Redis plugins to this service (they inject DATABASE_URL
# and REDIS_URL). Do not set PORT — Railway injects it.
#
# Service setup:
#   Root Directory: (repo root, empty)
#   Config file:    apps/api/railway.toml
#   Dockerfile:     apps/api/Dockerfile  (context = repo root)
# =============================================================================

NODE_ENV=production

# --- Injected by Railway plugins (paste only if you are not using plugins) ---
# DATABASE_URL=postgresql://user:pass@host:5432/railway?schema=public
# REDIS_URL=redis://default:pass@host:6379

# JWT (generate: openssl rand -base64 32)
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Cookies + CORS (custom domains — recommended) ---
# Web: ceylonweddings.com (Vercel) · API: api.ceylonweddings.com (Railway)
COOKIE_DOMAIN=.ceylonweddings.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CORS_ORIGINS=https://ceylonweddings.com,https://www.ceylonweddings.com

# --- Cookies + CORS (platform URLs only, no custom domain yet) ---
# COOKIE_DOMAIN=
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# CORS_ORIGINS=https://<project>.vercel.app

# PayHere return / notify URLs (read by the API, not the Next app)
NEXT_PUBLIC_SITE_URL=https://ceylonweddings.com
NEXT_PUBLIC_API_URL=https://api.ceylonweddings.com

# Google Identity (server). GIS popup keeps callback as postmessage.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=postmessage

# PayHere
PAYHERE_LIVE=true
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret

# S3 / CloudFront uploads
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=ceylon-weddings-media-prod
S3_PUBLIC_BASE_URL=https://cdn.ceylonweddings.com

# AI service on Railway private network (service name must match)
# Public URL also works: https://<ai>.up.railway.app
AI_SERVICE_URL=http://ceylon-ai.railway.internal:8001

# Email is rendered/queued but not sent until a transport is wired.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key
# EMAIL_FROM=Ceylon Weddings <hello@ceylonweddings.com>
