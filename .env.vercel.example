# =============================================================================
# Vercel → Project → Settings → Environment Variables
# Scope: Production + Preview + Development (same values except noted)
# App: apps/web (Root Directory = apps/web)
#
# NEXT_PUBLIC_* is inlined at BUILD time. After changing any of these,
# trigger a Redeploy. Do not put API secrets here.
# =============================================================================

# Public site URL (sitemap, robots, absolute links)
NEXT_PUBLIC_SITE_URL=https://ceylonweddings.com

# Railway API public URL (browser + Next.js server fetches)
NEXT_PUBLIC_API_URL=https://api.ceylonweddings.com
NEXT_PUBLIC_WS_URL=https://api.ceylonweddings.com

# Always "web" for this Next app
NEXT_PUBLIC_APP=web

# Same Google OAuth Web client ID as Railway GOOGLE_CLIENT_ID
# Cloud Console → Authorized JavaScript origins:
#   https://ceylonweddings.com
#   https://www.ceylonweddings.com
#   https://<project>.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Next/Image remote host (hostname only, no protocol)
# Must match the host of S3_PUBLIC_BASE_URL / CloudFront
NEXT_PUBLIC_S3_IMAGE_HOST=cdn.ceylonweddings.com

# Used at build time by next.config.ts if NEXT_PUBLIC_S3_IMAGE_HOST is empty
S3_PUBLIC_BASE_URL=https://cdn.ceylonweddings.com

# -----------------------------------------------------------------------------
# Preview-only (optional): point previews at the Railway API, then add the
# preview origin to Railway CORS_ORIGINS, e.g. https://<preview>.vercel.app
# Auth cookies across vercel.app ↔ railway.app need Railway:
#   COOKIE_SAME_SITE=none
#   COOKIE_SECURE=true
#   COOKIE_DOMAIN=          (leave empty)
# Custom domains (recommended) keep COOKIE_SAME_SITE=lax + COOKIE_DOMAIN=.ceylonweddings.com
# -----------------------------------------------------------------------------
