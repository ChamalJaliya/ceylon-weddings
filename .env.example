# Local development. Production paste-lists:
#   Vercel  → .env.vercel.example
#   Railway → .env.railway.example
#   AI      → .env.railway.ai.example

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://ceylon:ceylon@localhost:5432/ceylon_weddings?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP=web

# Google Identity (Create account → Sign up with Google)
# Cloud Console: OAuth client (Web). Authorized JavaScript origins: http://localhost:3000
# For the GIS popup code flow, callback may stay `postmessage`.
# If you use a server redirect instead, set GOOGLE_CALLBACK_URL to
# http://localhost:4000/auth/google/callback and add that URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=postmessage
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vendor media uploads (S3). Optional in local; required for Pro storefront uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# Public CDN or bucket URL used to build image URLs after upload (no trailing slash)
S3_PUBLIC_BASE_URL=
# Optional: hostname for Next.js image optimization (defaults to host of S3_PUBLIC_BASE_URL in next.config)
NEXT_PUBLIC_S3_IMAGE_HOST=

# ── AI Service (apps/ai) ─────────────────────────────────────────────────────
# URL of the FastAPI AI service (called only by the NestJS API, not the browser)
AI_SERVICE_URL=http://localhost:8001

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model overrides (optional — defaults shown)
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_STRUCTURED_MODEL=gpt-4o-mini
