{
  "name": "ceylon-weddings",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "node -e \"console.log('No dedicated linter configured')\"",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @ceylonweddings/database generate",
    "db:migrate": "pnpm --filter @ceylonweddings/database migrate",
    "db:seed": "pnpm --filter @ceylonweddings/database seed",
    "db:studio": "pnpm --filter @ceylonweddings/database studio",
    "ai:dev": "cd apps/ai && uvicorn app:app --reload --port 8001",
    "ai:test": "cd apps/ai && pytest tests/ -v"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
