# =============================================================================
# Railway → AI service (optional) → Variables
# Root Directory: apps/ai
# Config file:    apps/ai/railway.toml
# Do not set PORT — Railway injects it. The Nest API calls this service;
# the browser never does.
# =============================================================================

OPENAI_API_KEY=sk-...

# Optional model overrides
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_STRUCTURED_MODEL=gpt-4o-mini

# CORS allowlist on this service (browser CORS is unused; Nest calls it server-side)
NEST_API_URL=https://api.ceylonweddings.com
