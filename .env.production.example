# Combined production reference. For deploy, paste separately:
#   Vercel (web)     → .env.vercel.example
#   Railway (API)    → .env.railway.example
#   Railway (AI)     → .env.railway.ai.example
#
# Do not commit real values. Railway injects PORT, DATABASE_URL, REDIS_URL.

NODE_ENV=production

DATABASE_URL=postgresql://ceylon_prod_user:StrongPassword123@postgres-host:5432/ceylon_weddings?schema=public
REDIS_URL=redis://default:StrongRedisAuth@redis-host:6379

JWT_ACCESS_SECRET=your-production-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

COOKIE_DOMAIN=.ceylonweddings.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CORS_ORIGINS=https://ceylonweddings.com,https://www.ceylonweddings.com

NEXT_PUBLIC_SITE_URL=https://ceylonweddings.com
NEXT_PUBLIC_API_URL=https://api.ceylonweddings.com
NEXT_PUBLIC_WS_URL=https://api.ceylonweddings.com
NEXT_PUBLIC_APP=web

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=postmessage
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

PAYHERE_LIVE=true
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=ceylon-weddings-media-prod
S3_PUBLIC_BASE_URL=https://cdn.ceylonweddings.com
NEXT_PUBLIC_S3_IMAGE_HOST=cdn.ceylonweddings.com

AI_SERVICE_URL=http://ceylon-ai.railway.internal:8001
OPENAI_API_KEY=sk-...
NEST_API_URL=https://api.ceylonweddings.com
