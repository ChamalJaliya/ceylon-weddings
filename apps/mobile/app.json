{
  "expo": {
    "name": "Ceylon Weddings",
    "slug": "ceylon-weddings",
    "scheme": "ceylonweddings",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ceylonweddings.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Ceylon Weddings quickly with Face ID."
      }
    },
    "android": {
      "package": "com.ceylonweddings.app"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdfaf4",
          "dark": {
            "backgroundColor": "#15100c"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#fdfaf4"
  }
}
