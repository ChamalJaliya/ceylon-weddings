# API base URL as seen from the phone/simulator.
# iOS simulator: http://localhost:4000 · Android emulator: http://10.0.2.2:4000
# Physical phone: http://<your-mac-LAN-IP>:4000  (API must have COOKIE_SECURE=false in dev)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Website, for links to web-only tools (seating, music, moodboards…)
EXPO_PUBLIC_WEB_URL=http://localhost:3000
